{
  "type": "object",
  "description": "Final canonical schemas",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "Name of the canonical entity"
          },
          "canonical_schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Field key"
                },
                "name": {
                  "type": "string",
                  "description": "Field name."
                },
                "data_type": {
                  "type": "string",
                  "description": "Data type of the field, such as string, number, date, boolean, or currency."
                }
              },
              "propertyOrdering": [
                "name",
                "data_type"
              ]
            }
          },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_type": {
                  "type": "string",
                  "description": "Reference to original entity name"
                },
                "source_file": {
                  "type": "string",
                  "description": "Source file reference of the entity type"
                },
                "original_field": {
                  "type": "string",
                  "description": "Original field key"
                },
                "original_field_name": {
                  "type": "string",
                  "description": "Original field name"
                },
                "canonical_schema_field": {
                  "type": "string",
                  "description": "Field in canonical schema that is same as this field"
                }
              }
            }
          }
        },
        "required": [
          "entity_type",
          "canonical_schema",
          "mappings"
        ]
      }
    }
  }
  
}
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

enum WorkspaceState {
  DRAFT
  FILES_UPLOADED
  PARSING_COMPLETED
  EXTRACTION_COMPLETED
  SCHEMA_INFERRED
  USER_CONFIRMED_SCHEMA
  MAPPING_VALIDATION_COMPLETED
  COMPLETED
}

model workspace {
  id        String         @unique @default(uuid()) @db.Uuid()
  createdAt DateTime       @default(now())
  name      String         @default("New Workspace")
  state     WorkspaceState @default(DRAFT)
  error     Json?
  updatedAt DateTime       @updatedAt
  files     file[]
  schemas   schema[]
  rawData   rawdata[]
}

model file {
  id          String   @unique @default(uuid()) @db.Uuid()
  workspaceId String   @db.Uuid()
  name        String
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace workspace @relation(fields: [workspaceId], references: [id])
}

model schema {
  id             String @unique @default(uuid()) @db.Uuid()
  workspaceId    String @db.Uuid()
  entityType     String
  schema_fields  Json[] @default([])
  field_mappings Json[] @default([])

  workspace workspace @relation(fields: [workspaceId], references: [id])
}

model rawdata {
  workspaceId String    @unique() @db.Uuid()
  metadata    Json
  records     Json[]    @default([])
  entityTypes Json[]    @default([])
  workspace   workspace @relation(fields: [workspaceId], references: [id])
}

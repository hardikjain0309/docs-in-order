{
  "type": "object",
  "description": "Final canonical schemas",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "Name of the canonical entity"
          },
          "canonical_schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Field name."
                },
                "data_type": {
                  "type": "string",
                  "description": "Data type of the field, such as string, number, date, boolean, or currency."
                }
              },
              "propertyOrdering": [
                "name",
                "data_type"
              ]
            }
          },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_type": {
                  "type": "string",
                  "description": "Reference to original entity name"
                },
                "sourceFile": {
                  "type": "string",
                  "description": "Source file reference of the entity type"
                },
                "fieldName": {
                  "type": "string",
                  "description": "Original field name"
                },
                "canonical_schema_fieldName": {
                  "type": "string",
                  "description": "Name of field in canonical schema that is same as this field"
                }
              }
            }
          }
        }
      }
    }
  }
  
}